{
  "name": "dovo-studio",
  "version": "0.0.7",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @dovo/client-runtime build && vp run --parallel dev",
    "dev:api": "pnpm --filter @dovo/runtime... -r build && vp -C apps/api dev",
    "dev:desktop": "pnpm --filter @dovo/api... -r build && vp -C apps/desktop dev",
    "dev:mobile": "node scripts/build-mcp-apps.mjs && pnpm --filter @dovo/protocol --filter @dovo/client-runtime -r build && node scripts/build-mobile-terminal.mjs && node scripts/build-mobile-mermaid.mjs && pnpm --filter @dovo/mobile start",
    "dev:web": "pnpm --filter @dovo/protocol --filter @dovo/client-runtime -r build && vp -C apps/web dev",
    "build": "node scripts/build-mcp-apps.mjs && vp run -r build",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "fmt": "vp fmt",
    "fmt:fix": "vp fmt",
    "lint": "vp lint",
    "test": "pnpm --filter @dovo/api... -r build && vp test",
    "typecheck": "vp run -r typecheck",
    "fallow": "fallow dead-code",
    "fallow:ci": "fallow dead-code --format compact",
    "postinstall": "node scripts/build-mobile-icons.mjs && node scripts/prepare-pty.mjs && node scripts/build-mobile-terminal.mjs && node scripts/build-mobile-mermaid.mjs && node scripts/prepare-mobile-markdown.mjs && node scripts/build-browser-viewer.mjs && node scripts/build-mcp-apps.mjs",
    "package:desktop": "pnpm build && node scripts/packaging/package-desktop.mjs",
    "package:server": "node scripts/packaging/package-server.mjs",
    "package:desktop:artifacts": "node scripts/packaging/package-desktop.mjs",
    "pair": "pnpm --filter @dovo/api exec tsx src/cli.ts",
    "server": "pnpm --filter @dovo/api exec tsx src/server-cli.ts",
    "mobile:update": "node scripts/update-mobile.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm lint && pnpm build",
    "test:mcp-apps:browser": "node scripts/build-mcp-apps.mjs && node scripts/check-mcp-apps-browser.mjs",
    "test:artifacts:browser": "node scripts/check-artifacts-browser.mjs",
    "test:windows-runtime:browser": "node scripts/check-windows-runtime-browser.mjs",
    "test:turn-grouping:browser": "node scripts/check-turn-grouping-browser.mjs",
    "test:thread-streaming:browser": "node scripts/check-thread-streaming-browser.mjs",
    "test:composer-send:browser": "node scripts/check-composer-send-browser.mjs",
    "test:thread-startup:browser": "node scripts/check-thread-startup-browser.mjs",
    "test:mobile-notifications:browser": "node scripts/check-mobile-notifications-browser.mjs",
    "test:pull-links:browser": "node scripts/check-pull-links-browser.mjs && node scripts/check-thread-pull-links-browser.mjs",
    "test:scoped-settings:browser": "node scripts/check-scoped-settings-browser.mjs",
    "test:mobile-models:browser": "node scripts/check-mobile-models-browser.mjs",
    "test:mobile-thread-rendering:browser": "node scripts/check-mobile-thread-rendering.mjs",
    "test:conversation-history:browser": "node scripts/check-conversation-history-browser.mjs",
    "test:mobile-energy:browser": "node scripts/check-mobile-energy-browser.mjs",
    "test:linked-projects:browser": "node scripts/check-linked-projects-browser.mjs",
    "test:settings-target:browser": "node scripts/check-settings-target-browser.mjs",
    "test:scoped-agents:browser": "node scripts/check-scoped-agents-browser.mjs",
    "test:subagent-grouping:browser": "node scripts/check-subagent-grouping-browser.mjs",
    "test:shared-storage:browser": "node scripts/check-shared-storage-browser.mjs",
    "test:remote-browser-recovery:browser": "node scripts/check-remote-browser-recovery-browser.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "effect": "^3.22.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "fallow": "^3.22.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite-plus": "^0.3.0",
    "ws": "^8.21.3"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@12.3.4"
}
