+  /// Font family, applied through the shared controller's terminal
+  /// configuration (app-wide, merged with the theme). Ghostty falls back to
+  /// its embedded fonts for missing glyphs. A family CoreText cannot resolve
+  /// is reported instead of being passed through and silently ignored.
+  func applyFontFamily(_ family: String?) {
+    let name = family?.trimmingCharacters(in: .whitespacesAndNewlines) ?? ""
+    var config = TerminalConfiguration()
+    if !name.isEmpty {
+      if Self.fontFamilyAvailable(name) {
+        config = config.fontFamily(name)
+      } else {
+        onFontFallback([
+          "fontFamily": name,
+          "message": "Font family \(name) is not registered with this app.",
+        ])
+      }
+    }
+    _ = TerminalController.shared.setTerminalConfiguration(config)
+  }
+
+  /// Same family-attribute match ghostty's CoreText discovery performs.
+  private static func fontFamilyAvailable(_ name: String) -> Bool {
+    let descriptor = CTFontDescriptorCreateWithAttributes(
