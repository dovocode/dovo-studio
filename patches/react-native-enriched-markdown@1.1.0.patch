+// Elements outlive scrolling, keyboard changes and native tab layout transitions.
+// Resolve their screen coordinates when queried instead of caching an offscreen path.
+@interface ENRMLiveAccessibilityElement : UIAccessibilityElement
+@property (nonatomic, weak) UITextView *textView;
+@property (nonatomic) NSRange textRange;
+@end
+
+@implementation ENRMLiveAccessibilityElement
+- (UIBezierPath *)accessibilityPath
+{
+  UITextView *view = self.textView;
+  return view ? [MarkdownAccessibilityElementBuilder accessibilityPathForRange:self.textRange inTextView:view] : nil;
+}
+- (CGRect)accessibilityFrame
+{
+  UITextView *view = self.textView;
+  if (!view) return CGRectZero;
+  UIBezierPath *path = self.accessibilityPath;
+  if (path) return path.bounds;
+  CGRect frame = [MarkdownAccessibilityElementBuilder frameForRange:self.textRange
+                                                       inTextView:view
+                                                        container:self.accessibilityContainer];
+  return UIAccessibilityConvertFrameToScreenCoordinates(frame, self.accessibilityContainer);
+}
+@end
+#endif
