+- (void)drain
+{
+  while (YES) {
+    @autoreleasepool {
+      [_lock lock];
+      BOOL (^renderBlock)(void) = _pendingRender;
+      dispatch_block_t applyBlock = _pendingApply;
+      NSUInteger renderId = _currentRenderId;
+      _pendingRender = nil;
+      _pendingApply = nil;
