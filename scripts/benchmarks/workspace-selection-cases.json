      "expected": {
        "destination": "thread",
        "runtime": "keep",
        "model": "sol-6.1",
        "project": "none"
      }
    },
    {
      "text": "What is the difference between Opus 5.5 and Sol 6.1?",
      "expected": { "destination": "thread", "runtime": "keep", "model": "keep", "project": "keep" }
    },
    {
