{
  "description": "Manually authored acceptance cases for the catalog-conditioned classifier. These inputs are not training examples; unavailable selections must not invent IDs. Reserved keep/default/none values describe editable picker behavior, not routing rules.",
  "catalogs": {
    "runtime": [
      {
        "id": "keep",
        "label": "Keep the currently selected computer; no available computer requested"
      },
      { "id": "mac-studio", "label": "runtime: Mac Studio" },
      { "id": "macbook", "label": "runtime: Dominic's MacBook" },
      { "id": "linux", "label": "runtime: Linux Server" }
    ],
    "model": [
      {
        "id": "keep",
        "label": "Keep the currently selected AI model; no available model requested"
      },
      { "id": "opus-5.5", "label": "model: Opus 5.5" },
      { "id": "sol-6.1", "label": "model: Sol 6.1" },
      { "id": "fable-5.1", "label": "model: Fable 5.1" }
    ],
    "project": [
      {
        "id": "keep",
        "label": "Keep the currently selected project; no available project requested"
      },
      { "id": "none", "label": "No Project; home folder; outside any repository" },
      { "id": "dovo", "label": "project: Dovo Studio" },
      { "id": "shampoo", "label": "project: Shampoo" },
      { "id": "client", "label": "project: Client Website" }
    ],
    "profile": [
      { "id": "default", "label": "Default browser profile; no available named profile requested" },
      { "id": "work", "label": "profile: Work" },
      { "id": "personal", "label": "profile: Personal" },
      { "id": "testing", "label": "profile: Testing" }
    ]
  },
  "cases": [
    {
      "text": "claude -p \"nice\"",
      "expected": { "destination": "terminal", "runtime": "keep", "project": "keep" }
    },
    {
      "text": "dovocode.com/?lol=1",
      "expected": { "destination": "browser", "runtime": "keep", "profile": "default" }
    },
    {
      "text": "make my app accept claude -p \"prompt\" and accept dovocode.com",
      "expected": { "destination": "thread", "runtime": "keep", "model": "keep", "project": "keep" }
    },
    {
      "text": "open dovocode.com",
      "expected": { "destination": "browser", "runtime": "keep", "profile": "default" }
    },
    {
      "text": "please open dovocode.com/?lol=1",
      "expected": { "destination": "browser", "runtime": "keep", "profile": "default" }
    },
    {
      "text": "open dovocode.com in the default profile",
      "expected": { "destination": "browser", "runtime": "keep", "profile": "default" }
    },
    {
      "text": "open dovocode.com in my Work profile",
      "expected": { "destination": "browser", "runtime": "keep", "profile": "work" }
    },
    {
      "text": "open dovocode.com in the Work browser profile on Mac Studio",
      "expected": { "destination": "browser", "runtime": "mac-studio", "profile": "work" }
    },
    {
      "text": "Go to http://100.64.44.9:8787 in the Personal browser profile",
      "expected": { "destination": "browser", "runtime": "keep", "profile": "personal" }
    },
    {
      "text": "Navigate to localhost:4322 with profile Testing on Linux Server",
      "expected": { "destination": "browser", "runtime": "linux", "profile": "testing" }
    },
    {
      "text": "open -a Safari https://dovocode.com",
      "expected": { "destination": "terminal", "runtime": "keep", "project": "keep" }
    },
    {
      "text": "open -n -a Firefox --args https://dovocode.com",
      "expected": { "destination": "terminal", "runtime": "keep", "project": "keep" }
    },
    {
      "text": "open dovocode.com and explain the pricing",
      "expected": { "destination": "thread", "runtime": "keep", "model": "keep", "project": "keep" }
    },
    {
      "text": "Make my app open dovocode.com in the default profile",
      "expected": { "destination": "thread", "runtime": "keep", "model": "keep", "project": "keep" }
    },
    {
      "text": "Use Opus 5.5 on Mac Studio in project Dovo Studio to fix the login bug",
      "expected": {
        "destination": "thread",
        "runtime": "mac-studio",
        "model": "opus-5.5",
        "project": "dovo"
      }
    },
    {
      "text": "Use Sol 6.1 to review the code in project Shampoo",
      "expected": {
        "destination": "thread",
        "runtime": "keep",
        "model": "sol-6.1",
        "project": "shampoo"
      }
    },
    {
      "text": "Fix startup in Dovo Studio with Fable 5.1 on Mac Studio",
      "expected": {
        "destination": "thread",
        "runtime": "mac-studio",
        "model": "fable-5.1",
        "project": "dovo"
      }
    },
    {
      "text": "Model: Opus 5.5\nProject: Client Website\nComputer: Linux Server\nReview the accessibility issues",
      "expected": {
        "destination": "thread",
        "runtime": "linux",
        "model": "opus-5.5",
        "project": "client"
      }
    },
    {
