      "import": "./dist/effects/terminal-input.js",
      "default": "./dist/effects/terminal-input.js"
    },
    "./socket-heartbeat": {
      "types": "./src/effects/socket-heartbeat.ts",
      "development": "./src/effects/socket-heartbeat.ts",
      "import": "./dist/effects/socket-heartbeat.js",
      "default": "./dist/effects/socket-heartbeat.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-image-editor.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vp test"
