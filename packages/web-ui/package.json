{
  "name": "@dovo/web-ui",
  "version": "0.0.1",
  "private": true,
  "files": [
    "dist",
    "src/theme.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./src/button.tsx",
      "import": "./dist/button.js"
    },
    "./input": {
      "types": "./src/input.tsx",
      "import": "./dist/input.js"
    },
    "./textarea": {
      "types": "./src/textarea.tsx",
      "import": "./dist/textarea.js"
    },
    "./badge": {
      "types": "./src/badge.tsx",
      "import": "./dist/badge.js"
    },
    "./card": {
      "types": "./src/card.tsx",
      "import": "./dist/card.js"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./dist/server.js"
    },
    "./styles": {
      "types": "./dist/styles.d.ts",
      "import": "./dist/styles.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./src/theme.css",
    "./select": {
      "types": "./src/select.tsx",
      "import": "./dist/select.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node build-css.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dovo/design": "workspace:*",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
