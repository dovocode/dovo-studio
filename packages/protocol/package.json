{
  "name": "@dovo/protocol",
  "version": "0.0.1",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./request-timeout": {
      "types": "./src/shared/request-timeout.ts",
      "development": "./src/shared/request-timeout.ts",
      "import": "./dist/shared/request-timeout.js",
      "default": "./dist/shared/request-timeout.js"
    },
    "./browser-viewer": {
      "types": "./src/generated/browser-viewer.ts",
      "development": "./src/generated/browser-viewer.ts",
      "import": "./dist/generated/browser-viewer.js",
      "default": "./dist/generated/browser-viewer.js"
    },
    "./github-release-auth": {
      "types": "./src/node/github-release-auth.ts",
      "development": "./src/node/github-release-auth.ts",
      "import": "./dist/node/github-release-auth.js",
      "default": "./dist/node/github-release-auth.js"
    },
    "./local-settings": {
      "types": "./src/node/local-settings.ts",
      "development": "./src/node/local-settings.ts",
      "import": "./dist/node/local-settings.js",
      "default": "./dist/node/local-settings.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-browser-viewer.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "cron-parser": "^5.10.2",
    "effect": "4.0.5",
    "mdast-util-directive": "^3.1.1",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-directive": "^4.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "proper-lockfile": "4.1.2",
    "tweetnacl": "1.0.3",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/proper-lockfile": "^4.1.4"
  }
}
