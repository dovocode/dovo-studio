#!/bin/sh
# dovo-fetch <url> <sha256 or -> <directory> <command>: download an ACP Registry archive over
# HTTPS, check its SHA-256 when the Registry lists one, and unpack it into the directory. A file
# that is not an archive becomes the command itself.
set -eu
url=$1
sum=$2
destination=$3
command=${4#./}
[ -e "$destination/.dovo-complete" ] && exit 0
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
curl -fsSL --proto '=https' --proto-redir '=https' -o "$work/archive" "$url"
if [ "$sum" != "-" ]; then
  echo "$sum  $work/archive" | sha256sum -c - >/dev/null
fi
mkdir -p "$work/out"
case "$url" in
  *.zip) unzip -q "$work/archive" -d "$work/out" ;;
  *.tar.gz | *.tgz) tar -xzf "$work/archive" -C "$work/out" ;;
  *.tar.xz | *.txz) tar -xJf "$work/archive" -C "$work/out" ;;
  *.tar.bz2 | *.tbz2) tar -xjf "$work/archive" -C "$work/out" ;;
  *.tar.zst) tar --zstd -xf "$work/archive" -C "$work/out" ;;
  *.tar) tar -xf "$work/archive" -C "$work/out" ;;
  *)
    mkdir -p "$work/out/$(dirname "$command")"
    cp "$work/archive" "$work/out/$command"
    chmod 0755 "$work/out/$command"
    ;;
esac
mkdir -p "$(dirname "$destination")"
rm -rf "$destination"
mv "$work/out" "$destination"
touch "$destination/.dovo-complete"
