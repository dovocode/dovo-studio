# Generate a shared relay token with: openssl rand -hex 32
DOVO_RELAY_TOKEN=
# Apple APNs (optional when only Android is needed). Put AuthKey.p8 in secrets/apns.p8.
DOVO_APNS_KEY_ID=
DOVO_APNS_TEAM_ID=
# Firebase FCM (optional when only iOS is needed). Put the service account in secrets/firebase.json.
DOVO_FIREBASE_CREDENTIALS=
DOVO_FCM_PROJECT_ID=

# Optional: match the owner of mounted credential files when it is not UID/GID 1000.
DOVO_RELAY_UID=1000
DOVO_RELAY_GID=1000
