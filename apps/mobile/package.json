    "expo-sharing": "~57.0.22",
    "expo-speech": "~57.0.3",
    "expo-speech-recognition": "57.1.0",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-widgets": "~57.0.23",
    "lucide-react-native": "1.52.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mermaid": "^12.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-diffs": "^1.0.3",
    "react-native-enriched-markdown": "1.1.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-modules": "^0.35.10",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
