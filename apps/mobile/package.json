{
  "name": "@dovo/mobile",
  "version": "0.0.1",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prestart": "node ../../scripts/build-browser-viewer.mjs && node ../../scripts/build-mobile-terminal.mjs",
    "preios": "node ../../scripts/build-browser-viewer.mjs && node ../../scripts/build-mobile-terminal.mjs",
    "preandroid": "node ../../scripts/build-browser-viewer.mjs && node ../../scripts/build-mobile-terminal.mjs",
    "build": "node ../../scripts/build-browser-viewer.mjs && node ../../scripts/build-mobile-terminal.mjs"
  },
  "dependencies": {
    "@assistant-ui/core": "0.3.18",
    "@assistant-ui/react-native": "0.1.41",
    "@dovo/client-runtime": "workspace:*",
    "@dovo/protocol": "workspace:*",
    "@effect-atom/atom-react": "0.7.0",
    "@expo/ui": "57.0.18",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "assistant-cloud": "0.2.0",
    "diff": "^9.0.0",
    "effect": "^3.22.1",
    "expo": "~57.0.20",
    "expo-build-properties": "~57.0.17",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.2",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-glass-effect": "~57.0.3",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.18",
    "expo-speech-recognition": "57.1.0",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-widgets": "~57.0.20",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-diffs": "^1.0.3",
    "react-native-enriched-markdown": "1.0.2",
    "react-native-nitro-modules": "^0.35.10",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/metro-config": "^57.0.12",
    "@react-native/metro-config": "0.86.3",
    "@types/react": "^19.2.18",
    "babel-preset-expo": "^57.0.10"
  },
  "enriched-markdown": {
    "enableMath": false,
    "enableCodeHighlight": true,
    "codeHighlightLanguages": [
      "javascript",
      "typescript",
      "tsx",
      "json",
      "bash",
      "css",
      "html",
      "python",
      "yaml"
    ]
  }
}
