{
  "name": "@dovo/mobile",
  "version": "0.0.9",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "pnpm run prestart && expo start",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "pnpm run prepare:assets && sb-rn-get-stories --config-path .rnstorybook && tsc -p tsconfig.json --noEmit",
    "prestart": "pnpm --filter @dovo/design --filter @dovo/protocol --filter @dovo/client-runtime -r build && pnpm run build",
    "preios": "pnpm --filter @dovo/design --filter @dovo/protocol --filter @dovo/client-runtime -r build && pnpm run build",
    "preandroid": "pnpm --filter @dovo/design --filter @dovo/protocol --filter @dovo/client-runtime -r build && pnpm run build",
    "prepare:assets": "node ../../scripts/build-mobile-icons.mjs && node ../../scripts/build-mcp-apps.mjs && node ../../scripts/build-browser-viewer.mjs && node ../../scripts/build-mobile-terminal.mjs && node ../../scripts/build-mobile-desktop.mjs && node ../../scripts/build-mobile-mermaid.mjs",
    "build": "node ../../scripts/prepare-mobile-markdown.mjs && pnpm run prepare:assets",
    "storybook": "sb-rn-get-stories --config-path .rnstorybook && EXPO_PUBLIC_DOVO_STORYBOOK=1 expo start --clear",
    "storybook:ios": "sb-rn-get-stories --config-path .rnstorybook && EXPO_PUBLIC_DOVO_STORYBOOK=1 expo run:ios",
    "prestorybook": "pnpm run prestart",
    "prestorybook:ios": "pnpm run preios"
  },
  "dependencies": {
    "@assistant-ui/core": "0.3.32",
    "@assistant-ui/react-native": "0.1.51",
    "@dovo/client-runtime": "workspace:*",
    "@dovo/design": "workspace:*",
    "@dovo/protocol": "workspace:*",
    "@dovo/studio-core": "workspace:*",
    "@effect/atom-react": "4.1.1",
    "@expo/ui": "~58.0.26",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shikijs/core": "4.5.0",
    "@shikijs/langs": "4.5.0",
    "@shikijs/types": "4.5.0",
    "@shikijs/vscode-textmate": "10.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "assistant-cloud": "0.2.9",
    "diff": "^9.0.0",
    "effect": "4.1.1",
    "expo": "~58.0.22",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-glass-effect": "~58.0.5",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.7",
    "expo-quick-actions": "6.0.2",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-speech": "~58.0.3",
    "expo-speech-recognition": "58.0.1",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-widgets": "~58.0.26",
    "lucide-react-native": "1.66.0",
    "mdast-util-from-markdown": "^2.1.0",
    "pele": "^1.13.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-enriched-markdown": "1.1.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-shiki-engine": "0.5.0",
    "react-native-svg": "15.16.0",
    "react-native-tcp-socket": "6.4.3",
    "react-native-view-shot": "6.1.1",
    "react-native-webrtc": "155.0.1",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@expo/metro-config": "^58.0.20",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native/metro-config": "0.88.1",
    "@shikijs/engine-oniguruma": "4.5.0",
    "@storybook/addon-ondevice-actions": "10.7.1",
    "@storybook/addon-ondevice-controls": "10.7.1",
    "@storybook/react-native": "10.7.1",
    "@types/mdast": "^4.0.4",
    "@types/react": "~19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-preset-expo": "^58.0.23"
  },
  "enriched-markdown": {
    "enableMath": false,
    "enableCodeHighlight": true,
    "codeHighlightLanguages": [
      "javascript",
      "typescript",
      "tsx",
      "json",
      "bash",
      "css",
      "html",
      "python",
      "yaml"
    ]
  }
}
