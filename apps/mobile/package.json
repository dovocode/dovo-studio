{
  "name": "@dovo/mobile",
  "version": "0.0.9",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prestart": "node ../../scripts/build-mobile-icons.mjs && node ../../scripts/build-mcp-apps.mjs && node ../../scripts/build-browser-viewer.mjs && node ../../scripts/build-mobile-terminal.mjs && node ../../scripts/build-mobile-mermaid.mjs",
    "preios": "node ../../scripts/build-mobile-icons.mjs && node ../../scripts/build-mcp-apps.mjs && node ../../scripts/build-browser-viewer.mjs && node ../../scripts/build-mobile-terminal.mjs && node ../../scripts/build-mobile-mermaid.mjs",
    "preandroid": "node ../../scripts/build-mobile-icons.mjs && node ../../scripts/build-mcp-apps.mjs && node ../../scripts/build-browser-viewer.mjs && node ../../scripts/build-mobile-terminal.mjs && node ../../scripts/build-mobile-mermaid.mjs",
    "build": "node ../../scripts/build-mobile-icons.mjs && node ../../scripts/build-mcp-apps.mjs && node ../../scripts/build-browser-viewer.mjs && node ../../scripts/build-mobile-terminal.mjs && node ../../scripts/build-mobile-mermaid.mjs"
  },
  "dependencies": {
    "@assistant-ui/core": "0.3.24",
    "@assistant-ui/react-native": "0.1.46",
    "@dovo/client-runtime": "workspace:*",
    "@dovo/protocol": "workspace:*",
    "@dovo/studio-core": "workspace:*",
    "@effect/atom-react": "4.0.1",
    "@expo/ui": "~57.0.22",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "assistant-cloud": "0.2.5",
    "diff": "^9.0.0",
    "effect": "4.0.1",
    "expo": "~57.0.27",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-glass-effect": "~57.0.4",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
