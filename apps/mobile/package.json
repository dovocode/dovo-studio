{
  "name": "@dovo/mobile",
  "version": "0.0.9",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prestart": "pnpm --filter @dovo/protocol --filter @dovo/client-runtime -r build && node ../../scripts/build-mobile-icons.mjs && node ../../scripts/build-mcp-apps.mjs && node ../../scripts/build-browser-viewer.mjs && node ../../scripts/build-mobile-terminal.mjs && node ../../scripts/build-mobile-mermaid.mjs",
    "preios": "pnpm --filter @dovo/protocol --filter @dovo/client-runtime -r build && node ../../scripts/build-mobile-icons.mjs && node ../../scripts/build-mcp-apps.mjs && node ../../scripts/build-browser-viewer.mjs && node ../../scripts/build-mobile-terminal.mjs && node ../../scripts/build-mobile-mermaid.mjs",
    "preandroid": "pnpm --filter @dovo/protocol --filter @dovo/client-runtime -r build && node ../../scripts/build-mobile-icons.mjs && node ../../scripts/build-mcp-apps.mjs && node ../../scripts/build-browser-viewer.mjs && node ../../scripts/build-mobile-terminal.mjs && node ../../scripts/build-mobile-mermaid.mjs",
    "build": "node ../../scripts/build-mobile-icons.mjs && node ../../scripts/build-mcp-apps.mjs && node ../../scripts/build-browser-viewer.mjs && node ../../scripts/build-mobile-terminal.mjs && node ../../scripts/build-mobile-mermaid.mjs"
  },
  "dependencies": {
    "@assistant-ui/core": "0.3.28",
    "@assistant-ui/react-native": "0.1.47",
    "@dovo/client-runtime": "workspace:*",
    "@dovo/protocol": "workspace:*",
    "@dovo/studio-core": "workspace:*",
    "@effect/atom-react": "4.0.5",
    "@expo/ui": "~58.0.20",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shikijs/core": "4.5.0",
    "@shikijs/langs": "4.5.0",
    "@shikijs/types": "4.5.0",
    "@shikijs/vscode-textmate": "10.0.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "assistant-cloud": "0.2.7",
    "diff": "^9.0.0",
    "effect": "4.0.5",
    "expo": "~58.0.13",
    "expo-build-properties": "~58.0.10",
    "expo-camera": "~58.0.10",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.9",
