  "devDependencies": {
    "@expo/metro-config": "^57.0.12",
    "@react-native/metro-config": "0.86.3",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "^57.0.13"
  },
  "enriched-markdown": {
    "enableMath": false,
    "enableCodeHighlight": true,
    "codeHighlightLanguages": [
      "javascript",
      "typescript",
      "tsx",
      "json",
      "bash",
      "css",
      "html",
      "python",
      "yaml"
    ]
  }
}
