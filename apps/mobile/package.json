    "expo-image-manipulator": "~58.0.14",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-localization": "~58.0.4",
    "expo-network": "~58.0.3",
    "expo-notifications": "~58.1.5",
    "expo-quick-actions": "6.0.2",
    "expo-router": "~58.0.22",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.19",
    "expo-speech": "~58.0.3",
    "expo-speech-recognition": "58.0.0",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-widgets": "~58.0.20",
    "lucide-react-native": "1.57.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mermaid": "^12.2.0",
    "react": "19.3.0",
