{
  "manifest_version": 3,
  "name": "Dovo Fixture Extension",
  "version": "1.0.0",
  "description": "Test fixture: action popup, isolated-world content script and storage.",
  "permissions": ["storage", "nativeMessaging", "debugger"],
  "host_permissions": ["http://127.0.0.1/*"],
  "action": { "default_title": "Dovo Fixture", "default_popup": "popup.html" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end" }]
}
