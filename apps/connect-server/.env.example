# Operator secrets only. Never include these values in mobile/desktop builds.
DOVO_CONNECT_ORIGIN=https://connect.dovo.studio
# Exact immediate proxy IPs/CIDRs only. The proxy must sanitize incoming forwarded headers.
# Empty ignores forwarded headers; behind a proxy, all clients then share its rate limits.
DOVO_CONNECT_TRUSTED_PROXIES=
# Per provider: new credentials/hour, plus 20/approved installation/hour. Does not cap bytes.
DOVO_TURN_HOURLY_LIMIT=100
# Optional Dovo coturn relay. Configure BOTH fields, deploy turn/compose.yaml,
# and use the same random 32+ character secret on Connect and coturn.
DOVO_RELAY_TURN_URLS=
# Example: turn:turn.dovo.studio:3478?transport=udp,turn:turn.dovo.studio:3478?transport=tcp,turns:turn.dovo.studio:443?transport=tcp
DOVO_RELAY_TURN_SECRET=
# Comma-separated public relay approval keys copied from approved computers' Settings.
# Empty denies legacy account-free grants; active account-authorized installations still qualify.
# These are Ed25519 PUBLIC keys, never the runtime's private key or device token.
DOVO_RELAY_APPROVED_KEYS=
