{
  "name": "@dovo/design-system",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm prepare:catalog && storybook dev -p 6006 --no-open --disable-telemetry",
    "build": "pnpm prepare:catalog && storybook build --disable-telemetry",
