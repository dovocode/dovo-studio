{
  "name": "@dovo/api",
  "version": "0.0.1",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./connection": {
      "types": "./src/connection.ts",
      "development": "./src/connection.ts",
      "import": "./dist/connection.js",
      "default": "./dist/connection.js"
    },
    "./owner-token": {
      "types": "./src/owner-token.ts",
      "development": "./src/owner-token.ts",
      "import": "./dist/owner-token.js",
      "default": "./dist/owner-token.js"
    },
    "./runtime-environment": {
      "types": "./src/runtime-environment.ts",
      "development": "./src/runtime-environment.ts",
      "import": "./dist/runtime-environment.js",
      "default": "./dist/runtime-environment.js"
    },
    "./listen-address": {
      "types": "./src/listen-address.ts",
      "development": "./src/listen-address.ts",
      "import": "./dist/listen-address.js",
      "default": "./dist/listen-address.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dovo/protocol": "workspace:*",
    "@dovo/runtime": "workspace:*",
    "effect": "4.0.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15"
  }
}
